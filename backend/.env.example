# Application
APP_NAME=MPCashews
APP_ENV=development
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production
ALLOWED_HOSTS=["http://localhost:3000","http://localhost:8000"]

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/mpcashews_db
DATABASE_ECHO=False

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# NOTE: this points at the FRONTEND's /google/callback page (see
# frontendv2/src/app/google/callback/page.tsx), not the backend. That page
# reads the ?code= param and calls POST /api/v1/auth/google/callback itself
# — it's a client-side exchange, not a server-side redirect. Must exactly
# match a redirect URI registered on the Google Cloud OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:3000/google/callback

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Delivery Partner (Shiprocket)
SHIPROCKET_EMAIL=your-shiprocket-email
SHIPROCKET_PASSWORD=your-shiprocket-password
SHIPROCKET_API_URL=https://apiv2.shiprocket.in/v1/external

# File Upload
UPLOAD_DIR=static/uploads
MAX_FILE_SIZE_MB=5

# ImageKit.io (image hosting/CDN) — get these from your ImageKit dashboard: https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-imagekit-id

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Cookie
COOKIE_DOMAIN=
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# WhatsApp Business Cloud API (Meta)
# Get these from: https://developers.facebook.com/apps -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=your-whatsapp-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# WhatsApp template names (must match approved templates in Meta Business Manager)
WA_TEMPLATE_ORDER_CONFIRMED=order_confirmed
WA_TEMPLATE_ORDER_SHIPPED=order_shipped
WA_TEMPLATE_ORDER_CANCELLED=order_cancelled
WA_TEMPLATE_ORDER_DELIVERED=order_delivered
WA_TEMPLATE_ORDER_OUT_DELIVERY=order_out_for_delivery
WA_TEMPLATE_OTP=otp_verification
WA_TEMPLATE_LANGUAGE=en

# OTP
OTP_EXPIRE_MINUTES=10


SMTP_HOST= smtp.gmail.com
SMTP_PORT= 587
SMTP_USERNAME = murugan001ab@gmail.com
SMTP_PASSWORD = yoik wnvw xyie urdv 
SMTP_FROM_EMAIL = murugan001ab@gmail.com
SMTP_FROM_NAME= MPCashews
EMAIL_VERIFY_EXPIRE_HOURS = 24

# Frontend base URL — used to build the email-verification link
# ({FRONTEND_URL}/verify-email?token=...). Must match wherever the Next.js
# frontend actually runs (default dev port 3000), not the old Vite port 5173.
FRONTEND_URL=http://localhost:3000